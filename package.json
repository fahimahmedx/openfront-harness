{
  "name": "openfront-llm-harness",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "inst": "npm ci --ignore-scripts && npm --prefix OpenFrontIO run inst",
    "build": "concurrently --kill-others-on-fail \"tsc --noEmit\" \"vite build\"",
    "start": "tsx --tsconfig OpenFrontIO/tsconfig.json src/Server.ts",
    "test": "vitest run tests",
    "eval:neutral": "tsx --tsconfig OpenFrontIO/tsconfig.json src/evals/RunNeutralExpansionEval.ts",
    "eval:micro": "tsx --tsconfig OpenFrontIO/tsconfig.json src/evals/RunMicroEvalSuite.ts",
    "eval:fixtures": "tsx scripts/ExtractMicroEvalFixtures.ts",
    "eval:add-replays": "tsx --tsconfig OpenFrontIO/tsconfig.json scripts/AddEvalReplays.ts",
    "benchmark:validate-tasks": "tsx --tsconfig OpenFrontIO/tsconfig.json scripts/ValidateBenchmarkTasks.ts",
    "benchmark:smoke": "tsx --tsconfig OpenFrontIO/tsconfig.json scripts/BenchmarkSmoke.ts",
    "benchmark:verify": "tsx --tsconfig OpenFrontIO/tsconfig.json scripts/VerifyBenchmark.ts",
    "benchmark:run": "tsx --tsconfig OpenFrontIO/tsconfig.json scripts/RunBenchmark.ts",
    "sample": "tsx --tsconfig OpenFrontIO/tsconfig.json src/GenerateSample.ts",
    "verify:sample": "tsx --tsconfig OpenFrontIO/tsconfig.json src/VerifySample.ts",
    "refresh:sample": "cross-env REFRESH_SAMPLE=true tsx --tsconfig OpenFrontIO/tsconfig.json src/VerifySample.ts",
    "baseline:run": "tsx --tsconfig OpenFrontIO/tsconfig.json src/VisualBaselineRunner.ts",
    "baseline:run:controls": "cross-env BASELINE_INTERFACE=visual-controls-v1 tsx --tsconfig OpenFrontIO/tsconfig.json src/VisualBaselineRunner.ts",
    "baseline:run:naive": "cross-env BASELINE_INTERFACE=visual-naive-v1 tsx --tsconfig OpenFrontIO/tsconfig.json src/VisualBaselineRunner.ts",
    "export:x-article": "node scripts/export-x-package.mjs",
    "format": "prettier --ignore-unknown --write ."
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "ejs": "^5.0.2",
    "eventsource-parser": "^3.1.0",
    "express": "^5.2.1",
    "marked": "^18.0.5",
    "tsx": "^4.21.0",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/node": "^24.12.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "playwright": "^1.55.0",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.5"
  }
}
